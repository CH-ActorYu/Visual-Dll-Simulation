<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <VisualDistributionRoot Condition="'$(VisualDistributionRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\distribution\OpenCvDistance</VisualDistributionRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Visual.Abstractions" HintPath="$(VisualDistributionRoot)\Visual.Abstractions.dll" />
    <Reference Include="Visual.Image" HintPath="$(VisualDistributionRoot)\Visual.Image.dll" />
    <Reference Include="Visual.IO" HintPath="$(VisualDistributionRoot)\Visual.IO.dll" />
    <Reference Include="Visual.Vision.Contracts" HintPath="$(VisualDistributionRoot)\Visual.Vision.Contracts.dll" />
    <Reference Include="Visual.VisionBase" HintPath="$(VisualDistributionRoot)\Visual.VisionBase.dll" />
    <Reference Include="Visual.Distance" HintPath="$(VisualDistributionRoot)\Visual.Distance.dll" />
    <Reference Include="Visual.Engine.OpenCv" HintPath="$(VisualDistributionRoot)\Visual.Engine.OpenCv.dll" />
    <Reference Include="OpenCvSharp" HintPath="$(VisualDistributionRoot)\OpenCvSharp.dll" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(VisualDistributionRoot)\runtimes\**\*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(VisualDistributionRoot)\runtimes\win-x64\native\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
